# Secretos y configuración local: nunca se versionan (RNF-15)
.env
.env.*
!.env.example
*.pem
*.key
secrets/
supabase/.env
supabase/functions/.env
# Contraseñas generadas para las cuentas de prueba de Supabase local
pruebas/.credenciales_locales.json
# Credenciales de Wi-Fi y del controlador en cada placa
firmware/**/config.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Exportaciones locales
*.csv

# Editores y sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
