# Copie este archivo como .env y complete los valores de SU proyecto Supabase.
# Solo la URL del proyecto y la clave pública (anon / publishable).
# NUNCA ponga aquí la clave service_role, contraseñas ni el token del bot.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional: usuario del bot de Telegram (sin @) para mostrar el enlace de vinculación.
TELEGRAM_BOT_USUARIO=ecosistema_bebe_g1_bot
